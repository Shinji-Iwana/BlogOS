APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# BlogOSの管理者（AdminUserSeeder が使う。値はソースコードに書かない）
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ローカルPCのウイルス対策ソフトがHTTPS通信を検査する場合だけ、その証明書を加えた証明書ファイルを指定する。
# 本番（XServer）では設定しない（BLOGOS_DECISIONS.md D-18-06）
HTTP_CA_BUNDLE=

# BlogOSのAI機能のAPI実行（OpenAI API。ChatGPTの契約とは別。BLOGOS_DECISIONS.md D-24）。
# 空のままなら、API実行は選べない（手動実行だけ使える）
OPENAI_API_KEY=
# OpenAI の残高は、BlogOS の「AIの費用と残高」で登録した残高と課金から見込み、足りなくなる見込みなら実行しない（D-31-04）。
# 残高の見込みがこの額以下になったら画面で知らせる（米ドル）
BLOGOS_AI_CREDIT_WARNING_USD=3
# 月の支出の上限（米ドル。任意）。空なら上限を設けない（残高の見込みだけで判断する）
BLOGOS_AI_MONTHLY_BUDGET_USD=

# 楽天ウェブサービスのアプリID（教材の書籍の情報を、楽天ブックス書籍検索APIで取得する。無料。D-30）。
# 空のままなら使わない（AIのWeb検索と、ページの文章の貼り付けだけで調べる）
RAKUTEN_APPLICATION_ID=

# Google 連携の OAuth クライアント（Google Cloud。D-21-01）。リダイレクト URI は Google Cloud にも同じものを登録する
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/google/oauth/callback

# PageSpeed Insights API のキー（Google Cloud で作り、PageSpeed Insights API だけに制限する。無料。D-78）。空のままなら測らない
GOOGLE_PAGESPEED_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 開発環境・テスト・XServerのいずれもMySQLを使う（BLOGOS_DECISIONS.md D-12-05）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blogos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
